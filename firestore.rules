rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isLobbyMember(lobbyId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid));
    }

    function isLobbyOwner(lobbyId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.ownerId == request.auth.uid;
    }

    function isLobbyGM(lobbyId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.get('gmUid', '') == request.auth.uid;
    }

    // ── User data (personaggi, impostazioni) ─────────────────────────────────
    // Ogni utente può leggere e scrivere solo i propri dati.

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // ── Library (feats e spells pubblici) ────────────────────────────────────
    // Lettura pubblica; scrittura solo per utenti autenticati (admin check nel frontend).

    match /library/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ── Lobbies ───────────────────────────────────────────────────────────────

    match /lobbies/{lobbyId} {
      // Qualsiasi utente autenticato può leggere le lobby (serve per il join tramite codice).
      allow read: if isAuthenticated();

      // Solo utenti autenticati possono creare lobby, e devono essere l'owner.
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      // L'owner può modificare la lobby (es. chiuderla); il GM può aggiornare solo gmUid (trasferimento).
      allow update: if isLobbyOwner(lobbyId)
        || (isLobbyGM(lobbyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gmUid']));

      // Nessuno può eliminare documenti di lobby.
      allow delete: if false;

      // ── Members ────────────────────────────────────────────────────────────

      match /members/{memberId} {
        // Un utente può leggere il proprio documento membro (serve per verificare
        // se è già iscritto prima del join). I membri vedono tutta la lista.
        allow read: if isAuthenticated()
          && (memberId == request.auth.uid || isLobbyMember(lobbyId));

        // Un utente autenticato può aggiungere solo sé stesso come membro.
        allow create: if isAuthenticated()
          && memberId == request.auth.uid;

        // Un membro può aggiornare solo il proprio record (es. lastSeenAt).
        allow update: if isAuthenticated()
          && memberId == request.auth.uid;

        // Un membro può rimuovere solo sé stesso; l'owner può rimuovere chiunque.
        allow delete: if isAuthenticated()
          && (memberId == request.auth.uid || isLobbyOwner(lobbyId));
      }

      // ── Messages ───────────────────────────────────────────────────────────

      match /messages/{messageId} {
        // Solo i membri possono leggere i messaggi.
        allow read: if isLobbyMember(lobbyId);

        // Solo i membri possono inviare messaggi in lobby attive,
        // e devono firmare il messaggio con il proprio uid.
        // I messaggi con hidden: true sono consentiti solo al GM corrente.
        allow create: if isLobbyMember(lobbyId)
          && request.resource.data.senderId == request.auth.uid
          && get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.isActive == true
          && (!('hidden' in request.resource.data)
              || request.resource.data.hidden == false
              || isLobbyGM(lobbyId));

        // I messaggi non si modificano né si eliminano.
        allow update, delete: if false;
      }
    }
  }
}
